# Generated packet captures. Large (a real session is ~450 MB) and fully
# reproducible: scripts/export_events.py then itch_make_capture.
*.evbin
*.itchcap

# Licensed reference data pulled from Databento for the exchange-book
# validation (~116 MB compressed). Not redistributable; re-pull with
# scripts/pull_reference_snapshots.py. The PASS/FAIL summary it produces IS
# committed, in validation/results/.
*.dbn
*.dbn.zst

# Data & secrets (Databento pulls, API keys)
output/
output_archive/
data/*
!data/**/
!data/**/.gitkeep
*.parquet
*.csv
data/**/source.txt
!validation/reference_snapshots/.gitkeep
.env
.env.*
!.env.example

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Profiling / coverage
*.prof
gmon.out
htmlcov/
.coverage

# Agent skills (installed via `npx skills add`, not project source)
.agents/
skills-lock.json

# Bundled demo run - the only data that IS committed, so a deployed viewer
# has something to render. Synthetic (no API key), so nothing licensed.
!demo/
!demo/*.csv
!demo/*.json
!demo/*.parquet
